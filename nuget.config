<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Packages this repo depends on that are not published yet. The location is supplied by the
         environment rather than committed, so no machine-specific path lives in this file. -->
    <add key="local" value="%SOEX_NUGET_FEED%" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="XState" />
    </packageSource>
  </packageSourceMapping>
</configuration>
