{
  "id": "expense-approval",
  "version": "1.1.0",
  "initial": "reviewing",
  "context": { "claimId": null, "amount": 0 },
  "states": {
    "reviewing": {
      "invoke": {
        "id": "budget",
        "src": "reviewBudget",
        "onDone": [
          { "guard": "overBudget", "target": "rejected", "actions": "notifyRejected" },
          { "guard": "withinLimit", "target": "approved", "actions": "notifyApproved" },
          { "target": "submitted" }
        ]
      }
    },
    "submitted": {
      "on": {
        "approve": { "target": "approved", "actions": "notifyApproved" },
        "reject": { "target": "rejected", "actions": "notifyRejected" }
      },
      "after": { "2000": { "target": "escalated" } }
    },
    "escalated": {
      "entry": "notifyEscalated",
      "on": {
        "approve": { "target": "approved", "actions": "notifyApproved" },
        "reject": { "target": "rejected", "actions": "notifyRejected" }
      }
    },
    "approved": { "type": "final", "output": { "outcome": "approved" } },
    "rejected": { "type": "final", "output": { "outcome": "rejected" } }
  }
}
